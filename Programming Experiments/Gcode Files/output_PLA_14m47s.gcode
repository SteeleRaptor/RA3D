; EXECUTABLE_BLOCK_START
M73 P0 R14
M201 X1000 Y1000 Z1000 E1000
M203 X50 Y50 Z50 E100
M204 P1000 R1000 T1000
M205 X10.00 Y10.00 Z2.00 E2.50 ; sets the jerk limits, mm/sec
;TYPE:Custom
M220 S100 ;Reset feed rate 
M221 S100 ;Reset flow rate 

M140 S55 ;Set final bed temp
G28 ;Home 
G92 E0 ;Reset extruder 
G1 Z2.0 F3000 ;Move Z Axis up 
G1 X10.1 Y20 Z0.28 F5000.0 ;Move to start position 
M190 S55 ;Wait for bed temp to stabilize
M109 S220 ;Wait for nozzle temp to stabilize
G1 X10.1 Y145.0 Z0.28 F1500.0 E15 ;Draw the first line 
G1 X10.4 Y145.0 Z0.28 F5000.0 ;Move to side a little 
G1 X10.4 Y20 Z0.28 F1500.0 E30 ;Draw the second line 
G92 E0 ;Reset extruder 
G1 E-1.0000 F1800 ;Retract a bit 
M73 P1 R14
G1 Z2.0 F3000 ;Move Z Axis up 
G1 E0.0000 F1800
G90
G21
M83 ; use relative distances for extrusion
; filament start gcode
M106 P3 S255


T0
M106 S0
;LAYER_CHANGE
;Z:0.5
;HEIGHT:0.5
;BEFORE_LAYER_CHANGE
